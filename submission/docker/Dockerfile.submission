# Self-contained AIC GR00T policy image for submission.
# All assets (GR00T base model, fine-tuned checkpoint, RLinf venv, uv-managed
# Python 3.11) are baked into the image — no host bind-mounts required.
#
# Build context expected layout:
#   ctx/
#   ├── Dockerfile                      (this file)
#   ├── inject_ur5e_stats.py
#   ├── entrypoint.sh
#   ├── aic_example_policies/           (from this repo)
#   ├── aic_model/                      (from this repo)
#   ├── aic_interfaces/                 (from this repo)
#   ├── aic_utils/                      (from this repo)
#   ├── pixi.toml, pixi.lock, pixi_env_setup.sh
#   ├── models/gr00t-n1.5-3b/           (from HF nvidia/GR00T-N1.5-3B)
#   ├── checkpoint/full_weights.pt      (selected checkpoint)
#   ├── rlinf/                          (from Phy-Lab-aic/RLinf, includes .venv)
#   ├── uv-python/                      (uv-managed Python 3.11 install dir)
#   └── stats/ur5e_stats.json           (from HF Phy-lab/pretrained_dataset_v3 meta/stats.json)
#
# Tip: use `cp -al` (hard links) to compose ctx without doubling disk usage.

FROM docker.io/library/ros:kilted-ros-core

# --- system deps + pixi ---------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates python3 python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://pixi.sh/install.sh | bash
ENV PATH="/root/.pixi/bin:$PATH"

# --- aic source -----------------------------------------------------------
COPY aic_example_policies /ws_aic/src/aic/aic_example_policies
COPY aic_model            /ws_aic/src/aic/aic_model
COPY aic_interfaces       /ws_aic/src/aic/aic_interfaces
COPY aic_utils            /ws_aic/src/aic/aic_utils
COPY pixi.toml pixi.lock  /ws_aic/src/aic/
COPY pixi_env_setup.sh    /ws_aic/src/aic/

# --- pixi env (Python 3.12, ROS2) ----------------------------------------
SHELL ["/bin/bash", "-c"]
RUN cd /ws_aic/src/aic && pixi install --locked
RUN /ws_aic/src/aic/.pixi/envs/default/bin/python -m ensurepip --upgrade && \
    /ws_aic/src/aic/.pixi/envs/default/bin/python -m pip install --no-input pyzmq

# --- helpers (small; come before big COPYs for layer cache efficiency) ----
COPY inject_ur5e_stats.py /opt/inject_ur5e_stats.py
COPY entrypoint.sh        /entrypoint.sh
RUN chmod 755 /entrypoint.sh

# --- ur5e dataset stats (small) ------------------------------------------
COPY stats/ur5e_stats.json /opt/stats/ur5e_stats.json

# --- GR00T base model (~5 GB) --------------------------------------------
COPY models/gr00t-n1.5-3b /opt/models/gr00t-n1.5-3b

# --- pre-inject ur5e stats at build time ---------------------------------
RUN python3 /opt/inject_ur5e_stats.py \
        --model-dir /opt/models/gr00t-n1.5-3b \
        --stats-json /opt/stats/ur5e_stats.json

# --- fine-tuned checkpoint (~5 GB) ---------------------------------------
COPY checkpoint/full_weights.pt /opt/checkpoints/full_weights.pt

# --- uv-managed Python 3.11 (RLinf venv shebangs/symlinks point here) -----
# Must preserve the exact host path /home/graphai/.local/share/uv/python so
# the venv inside RLinf keeps working without re-pinning interpreter paths.
COPY uv-python /home/graphai/.local/share/uv/python

# --- RLinf repo + .venv (~13 GB) -----------------------------------------
COPY rlinf /home/graphai/project/aic/RLinf

# --- defaults pointing to internal paths ---------------------------------
ENV GROOT_MODEL_PATH=/opt/models/gr00t-n1.5-3b \
    GROOT_CHECKPOINT_PATH=/opt/checkpoints/full_weights.pt \
    AIC_UR5E_STATS_JSON=/opt/stats/ur5e_stats.json \
    RLINF_PATH=/home/graphai/project/aic/RLinf \
    RLINF_PYTHON=/home/graphai/project/aic/RLinf/.venv/bin/python

WORKDIR /ws_aic/src/aic
ENTRYPOINT ["/entrypoint.sh"]
CMD ["--ros-args", "-p", "policy:=aic_example_policies.ros.RunGR00T", "-p", "use_sim_time:=true"]
